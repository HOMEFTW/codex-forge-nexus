{
  "schemaVersion": 1,
  "apiVersion": 4,
  "id": "homeftw.nexus",
  "name": "星枢 Nexus",
  "version": "0.3.2",
  "description": "独立安装的知识库插件：笔记渲染编辑、双向链接、图谱、数据库、模板、日记和模型工具。无需运行 Obsidian。",
  "compatibility": {
    "forge": [
      ">=0.7.0"
    ]
  },
  "permissions": [
    "panels",
    "sidebar",
    "conversation.read",
    "browser",
    "nexus.read",
    "nexus.write",
    "nexus.script"
  ],
  "capabilities": [
    {
      "name": "panels",
      "version": 1
    },
    {
      "name": "browser",
      "version": 1
    },
    {
      "name": "nexus",
      "version": 1
    }
  ],
  "contributes": {
    "panels": [
      {
        "id": "main",
        "title": "星枢 Nexus",
        "entry": "panel.html",
        "placement": "right"
      }
    ],
    "sidebar": [
      {
        "id": "open",
        "title": "星枢 Nexus",
        "panel": "main",
        "icon": {
          "viewBox": "0 0 24 24",
          "paths": [
            "M12 7.25 13.4 10.6 16.75 12 13.4 13.4 12 16.75 10.6 13.4 7.25 12 10.6 10.6Z",
            "M4.1 8.5A8.65 8.65 0 0 1 16 4.25M19.9 15.5A8.65 8.65 0 0 1 8 19.75",
            "M20.6 5.4a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0M6.4 18.6a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0"
          ]
        }
      }
    ]
  },
  "changelog": [
    {
      "version": "0.3.2",
      "date": "2026-11-13",
      "items": [
        "最低 Forge 版本提升至 0.7.0，继续不限制官方 Codex 客户端版本。",
        "沿用 API 4 与 Nexus v1，通过 Forge API 5 宿主的兼容层运行；现有功能和权限保持不变。"
      ]
    },
    {
      "version": "0.3.1",
      "date": "2026-11-12",
      "items": [
        "移除官方 Codex 客户端版本限制，由 Forge 负责客户端适配；要求 Forge >=0.6.1 <0.7.0，API 声明保持 4。",
        "保留原有权限、知识库连接、设置、存储与启用意愿，支持从 0.3.0 覆盖升级。"
      ]
    },
    {
      "version": "0.3.0",
      "date": "2026-11-11",
      "items": [
        "适配 Forge 0.6.0 / API 4，客户端基线为 26.1103.7773.0；旧 API 3 宿主请使用星枢 0.2.3。",
        "沿用 Nexus v1 公共接口和原有权限，支持从 0.2.3 覆盖升级并保留启用意愿、设置、存储和知识库连接。"
      ]
    },
    {
      "version": "0.2.3",
      "date": "2026-11-10",
      "items": [
        "适配 Forge 0.5.2 / API 3 的官方客户端基线 26.1103.7773.0。",
        "保留既有客户端支持与原有权限，验证从 0.2.2 覆盖升级后的启用状态和数据保留。"
      ]
    },
    {
      "version": "0.2.2",
      "date": "2026-11-09",
      "items": [
        "适配 Forge 0.5.0 / API 3 的官方客户端基线 26.1103.4239.0。",
        "保留既有客户端兼容，支持从 0.2.1 覆盖升级并在重启后恢复启用状态和知识库连接。"
      ]
    },
    {
      "version": "0.2.1",
      "date": "2026-11-04",
      "items": [
        "适配 Forge 0.4.3 / API 3 的官方客户端基线 26.1029.7803.0。",
        "保留 Forge 0.4.2 与旧客户端基线 26.1027.6604.0 的兼容支持。"
      ]
    },
    {
      "version": "0.2.0",
      "date": "2026-11-04",
      "items": [
        "入口仅保留左侧边栏，使用星形轨道专用图标。",
        "增加 DataviewJS 隔离查询、统计卡片与 Charts 兼容渲染，点击后运行。"
      ]
    },
    {
      "version": "0.1.0",
      "date": "2026-11-04",
      "items": [
        "首次独立插件发布，界面与渲染依赖随插件包交付，通过 Forge Nexus API 访问用户连接的知识库。"
      ]
    }
  ]
}
